# .env 配置示例 - 把这个文件复制为 .env，填入你自己的配置
#
# Lesson 6 用到的 LLM 配置（OpenAI-compatible 接口）
# 不管接哪家服务，业务代码一行不动，只改下面这三个变量即可切换。

# 方案 A: 第三方聚合服务（推荐学习用，一个 key 通 N 个模型，可做多模型对比）
OPENAI_API_KEY=your_aggregator_key_here
OPENAI_BASE_URL=https://ai.rosmontis.de/v1
LLM_MODEL=gpt-oss-120b

# 方案 B: 智谱 GLM 官方
# OPENAI_API_KEY=your_glm_api_key_here
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-4-flash

# 方案 C: OpenAI 原版
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-3.5-turbo

# 方案 D: DeepSeek（同样是 OpenAI-compatible）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
